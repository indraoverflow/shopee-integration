# Shopee Open Platform credentials. Never commit the real file.
# Sandbox partner id and key come from the Open Platform console for the test
# environment; they only work against the sandbox host.
PARTNER_ID=2001887
PARTNER_KEY=replace-with-your-partner-key

# sandbox or production
SHOPEE_ENV=sandbox

# The sandbox host differs per environment and is not the one most guides print.
# Read "Request URL" in the console's API Test Tool, then override here if needed.
# SHOPEE_BASE_URL=https://openplatform.sandbox.test-stable.shopee.sg

# Where Shopee redirects the seller after authorizing the app. Must match the
# redirect configured for the app in the console.
REDIRECT_URL=http://localhost:3000/auth/callback

# Public URL of this service, used to verify the Push signature, which is
# HMAC-SHA256(url + raw body). Leave unset to skip signature verification in
# local development only.
PUBLIC_URL=http://localhost:3000/webhook/shopee

PORT=3000

# Where access and refresh tokens are written. Unset keeps them in memory, which
# loses every authorization on restart.
TOKEN_STORE_PATH=./data/tokens.json

# Shared secret for /shop/info. Unset leaves the endpoint open, which is fine on
# localhost and wrong behind a public tunnel: anyone who knows a shop id could
# read its name. Send it as the x-shop-info-token header.
SHOP_INFO_TOKEN=replace-with-a-24-byte-hex-secret
