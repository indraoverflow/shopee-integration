{
  "name": "shopee-integration",
  "version": "0.3.0",
  "description": "Typed client, OAuth flow and webhook receiver for the Shopee Open Platform API v2",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "auth-url": "node --env-file-if-exists=.env dist/cli.js",
    "verify": "node --env-file-if-exists=.env dist/verify.js",
    "diagnose": "node --env-file-if-exists=.env dist/diagnose.js",
    "exchange": "node --env-file-if-exists=.env dist/exchange.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  }
}
